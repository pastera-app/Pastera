    "Automatic Paste" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatic Paste"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatisch einfügen"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incolla automaticamente"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動ペースト"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自动粘贴"
          }
        }
      }
    },
    "Automatic Paste Permission Description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When Automatic Paste is enabled, Pastera restores the target app and sends Command+V after you choose a history item or snippet. macOS requires Accessibility permission for that action. When this is off, Pastera only copies to the clipboard and you paste manually."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn „Automatisch einfügen“ aktiviert ist, stellt Pastera nach der Auswahl eines Verlaufseintrags oder Snippets die Ziel-App wieder her und sendet Command+V. macOS benötigt dafür die Bedienungshilfen-Berechtigung. Ist die Option deaktiviert, kopiert Pastera nur in die Zwischenablage und Sie fügen manuell ein."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando Incolla automaticamente è attivo, Pastera ripristina l'app di destinazione e invia Command+V dopo la selezione di un elemento della cronologia o di uno snippet. macOS richiede l'autorizzazione Accessibilità per questa operazione. Se l'opzione è disattivata, Pastera copia soltanto negli appunti e l'incollaggio resta manuale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動ペーストを有効にすると、履歴項目またはスニペットを選択した後にPasteraが対象アプリを復元し、Command+Vを送信します。この操作にはmacOSのアクセシビリティ権限が必要です。無効の場合はクリップボードへのコピーのみ行い、手動で貼り付けます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启自动粘贴后，Pastera 会在你选择历史或片段时恢复目标应用并发送 Command+V。macOS 要求这类操作获得“辅助功能”权限；关闭后只复制到剪贴板，需要你手动粘贴。"
          }
        }
      }
    },
    "Automatic Paste Permission Info" : {
