{
  "sourceLanguage" : "en",
  "strings" : {
    "A new version of Pastera is available" : { "localizations" : {
      "en" : { "stringUnit" : { "state" : "translated", "value" : "A new version of Pastera is available" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Eine neue Version von Pastera ist verfügbar" } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "È disponibile una nuova versione di Pastera" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "Pastera の新しいバージョンが利用できます" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "新版本的 Pastera 已经发布" } }
    } },
    "Pastera %@ is available. You currently have version %@." : { "localizations" : {
      "en" : { "stringUnit" : { "state" : "translated", "value" : "Pastera %@ is available. You currently have version %@." } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Pastera %@ ist verfügbar. Installiert ist Version %@." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Pastera %@ è disponibile. La versione attuale è %@." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "Pastera %@ が利用できます。現在のバージョンは %@ です。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Pastera %@ 可供下载，当前版本是 %@。" } }
    } },
    "View Release Notes" : { "localizations" : {
      "en" : { "stringUnit" : { "state" : "translated", "value" : "View Release Notes" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Versionshinweise anzeigen" } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Visualizza note di rilascio" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "リリースノートを表示" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "查看版本说明" } }
    } },
    "Download and install this update, then restart Pastera." : { "localizations" : {
      "en" : { "stringUnit" : { "state" : "translated", "value" : "Download and install this update, then restart Pastera." } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Lade dieses Update, installiere es und starte Pastera anschließend neu." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Scarica e installa questo aggiornamento, quindi riavvia Pastera." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "アップデートをダウンロードしてインストールし、Pastera を再起動します。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "下载并安装更新，然后重新启动 Pastera。" } }
    } },
    "The update has been downloaded and is ready to install." : { "localizations" : {
      "en" : { "stringUnit" : { "state" : "translated", "value" : "The update has been downloaded and is ready to install." } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Das Update wurde geladen und kann installiert werden." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "L'aggiornamento è stato scaricato ed è pronto per l'installazione." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "アップデートのダウンロードが完了し、インストールの準備ができました。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "更新已下载，已准备好安装。" } }
    } },
    "The update is ready. Update now to restart Pastera, or install it when Pastera quits." : { "localizations" : {
      "en" : { "stringUnit" : { "state" : "translated", "value" : "The update is ready. Update now to restart Pastera, or install it when Pastera quits." } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Das Update ist bereit. Aktualisiere jetzt, um Pastera neu zu starten, oder installiere es beim Beenden von Pastera." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "L'aggiornamento è pronto. Aggiorna ora per riavviare Pastera oppure installalo alla chiusura di Pastera." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "アップデートの準備ができました。今すぐ更新して Pastera を再起動するか、Pastera の終了時にインストールできます。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "更新已准备就绪。点击“更新”将重新启动 Pastera，或在退出 Pastera 时安装。" } }
    } },
    "Install on Quit" : { "localizations" : {
      "en" : { "stringUnit" : { "state" : "translated", "value" : "Install on Quit" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Beim Beenden installieren" } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Installa all'uscita" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "終了時にインストール" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "退出时安装" } }
    } },
    "Download the verified disk image here, then finish installation in Finder." : { "localizations" : {
      "en" : { "stringUnit" : { "state" : "translated", "value" : "Download the verified disk image here, then finish installation in Finder." } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Lade das geprüfte Image hier und schließe die Installation im Finder ab." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Scarica qui l'immagine verificata, quindi completa l'installazione nel Finder." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "検証済みのディスクイメージをダウンロードし、Finder でインストールを完了します。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "在应用内下载并校验磁盘映像，然后在访达中完成安装。" } }
    } },
    "Skip This Version" : { "localizations" : {
      "en" : { "stringUnit" : { "state" : "translated", "value" : "Skip This Version" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Diese Version überspringen" } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Ignora questa versione" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "このバージョンをスキップ" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "跳过这个版本" } }
    } },
    "Remind Me Later" : { "localizations" : {
      "en" : { "stringUnit" : { "state" : "translated", "value" : "Remind Me Later" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Später erinnern" } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Ricordamelo più tardi" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "あとで通知" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "稍后提醒我" } }
    } },
    "Download Update" : { "localizations" : {
      "en" : { "stringUnit" : { "state" : "translated", "value" : "Download Update" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Update laden" } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Scarica aggiornamento" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "アップデートをダウンロード" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "下载更新" } }
    } },
    "Preparing the update download…" : { "localizations" : {
      "en" : { "stringUnit" : { "state" : "translated", "value" : "Preparing the update download…" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Update-Download wird vorbereitet…" } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Preparazione del download…" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ダウンロードを準備中…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在准备下载更新…" } }
    } },
    "Downloading update… %d%%" : { "localizations" : {
      "en" : { "stringUnit" : { "state" : "translated", "value" : "Downloading update… %d%%" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Update wird geladen… %d%%" } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Download aggiornamento… %d%%" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "アップデートをダウンロード中… %d%%" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在下载更新… %d%%" } }
    } },
    "Verifying the downloaded update…" : { "localizations" : {
      "en" : { "stringUnit" : { "state" : "translated", "value" : "Verifying the downloaded update…" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Heruntergeladenes Update wird geprüft…" } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Verifica dell'aggiornamento scaricato…" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ダウンロードしたアップデートを検証中…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在校验已下载的更新…" } }
    } },
    "The disk image is ready. Drag Pastera to Applications to finish installing. If macOS blocks the app, open Privacy & Security settings and choose Open Anyway. Saved to %@." : { "localizations" : {
      "en" : { "stringUnit" : { "state" : "translated", "value" : "The disk image is ready. Drag Pastera to Applications to finish installing. If macOS blocks the app, open Privacy & Security settings and choose Open Anyway. Saved to %@." } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Das Image ist bereit. Ziehe Pastera zum Abschluss in Programme. Falls macOS die App blockiert, wähle unter Datenschutz & Sicherheit „Dennoch öffnen“. Gespeichert unter %@." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "L'immagine è pronta. Trascina Pastera in Applicazioni. Se macOS blocca l'app, scegli Apri comunque in Privacy e sicurezza. Salvata in %@." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ディスクイメージの準備ができました。Pastera をアプリケーションにドラッグしてください。macOS にブロックされた場合は「プライバシーとセキュリティ」で「このまま開く」を選びます。保存先: %@。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "磁盘映像已打开。请将 Pastera 拖入“应用程序”以完成安装。如果 macOS 阻止打开，请前往“隐私与安全性”并选择“仍要打开”。文件已保存到 %@。" } }
    } },
    "Open Installer" : { "localizations" : {
      "en" : { "stringUnit" : { "state" : "translated", "value" : "Open Installer" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Installer öffnen" } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Apri installer" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "インストーラを開く" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "打开安装包" } }
    } },
    "Try Again" : { "localizations" : {
      "en" : { "stringUnit" : { "state" : "translated", "value" : "Try Again" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Erneut versuchen" } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Riprova" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "もう一度試す" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "重试" } }
    } },
    "The update download was canceled. You can try again." : { "localizations" : {
      "en" : { "stringUnit" : { "state" : "translated", "value" : "The update download was canceled. You can try again." } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Der Update-Download wurde abgebrochen. Du kannst es erneut versuchen." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Il download è stato annullato. Puoi riprovare." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ダウンロードをキャンセルしました。もう一度試すことができます。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "更新下载已取消，可以重新尝试。" } }
    } },
    "The update was downloaded, but the disk image could not be opened. Open it from Downloads or view the release page for help." : { "localizations" : {
      "en" : { "stringUnit" : { "state" : "translated", "value" : "The update was downloaded, but the disk image could not be opened. Open it from Downloads or view the release page for help." } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Das Update wurde geladen, aber das Image konnte nicht geöffnet werden. Öffne es aus Downloads oder nutze die Release-Seite." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "L'aggiornamento è stato scaricato, ma l'immagine non può essere aperta. Aprila da Download o consulta la pagina della versione." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ダウンロードは完了しましたが、ディスクイメージを開けませんでした。ダウンロードフォルダまたはリリースページから開いてください。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "更新已下载，但无法打开磁盘映像。请从“下载”文件夹手动打开，或查看版本页面获取帮助。" } }
    } },
    "The downloaded update failed verification and was not opened. Try again or use the release page." : { "localizations" : {
      "en" : { "stringUnit" : { "state" : "translated", "value" : "The downloaded update failed verification and was not opened. Try again or use the release page." } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Die Prüfung des Updates ist fehlgeschlagen; es wurde nicht geöffnet. Versuche es erneut oder nutze die Release-Seite." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "La verifica dell'aggiornamento non è riuscita e il file non è stato aperto. Riprova o usa la pagina della versione." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "アップデートの検証に失敗したため開きませんでした。再試行するかリリースページを利用してください。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "更新文件校验失败，未执行打开操作。请重试或使用版本页面下载。" } }
    } },
    "The update download did not come from the official Pastera release and was blocked." : { "localizations" : {
      "en" : { "stringUnit" : { "state" : "translated", "value" : "The update download did not come from the official Pastera release and was blocked." } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Der Download stammt nicht aus einer offiziellen Pastera-Version und wurde blockiert." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Il download non proviene da una versione ufficiale di Pastera ed è stato bloccato." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "公式の Pastera リリースではないため、ダウンロードをブロックしました。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "更新文件并非来自 Pastera 官方版本，已阻止下载。" } }
    } },
    "Pastera could not save the installer in Downloads. Check folder access and try again." : { "localizations" : {
      "en" : { "stringUnit" : { "state" : "translated", "value" : "Pastera could not save the installer in Downloads. Check folder access and try again." } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Pastera konnte den Installer nicht in Downloads speichern. Prüfe den Ordnerzugriff und versuche es erneut." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Pastera non può salvare l'installer in Download. Verifica l'accesso alla cartella e riprova." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "インストーラをダウンロードフォルダに保存できませんでした。フォルダへのアクセスを確認してください。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法将安装包保存到“下载”文件夹。请检查文件夹访问权限后重试。" } }
    } },
    "Pastera could not download this update. Check your connection and try again, or view the release page." : { "localizations" : {
      "en" : { "stringUnit" : { "state" : "translated", "value" : "Pastera could not download this update. Check your connection and try again, or view the release page." } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Pastera konnte das Update nicht laden. Prüfe die Verbindung und versuche es erneut oder öffne die Release-Seite." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Pastera non può scaricare l'aggiornamento. Verifica la connessione e riprova oppure apri la pagina della versione." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "アップデートをダウンロードできませんでした。接続を確認して再試行するか、リリースページを開いてください。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法下载更新。请检查网络连接后重试，或打开版本页面下载。" } }
    } },
    "Automatic Updates" : { "localizations" : {
      "en" : { "stringUnit" : { "state" : "translated", "value" : "Automatic Updates" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Automatische Updates" } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Aggiornamenti automatici" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "自動アップデート" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "自动更新" } }
    } },
    "Checking for Updates…" : { "localizations" : {
      "en" : { "stringUnit" : { "state" : "translated", "value" : "Checking for Updates…" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Suche nach Updates…" } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Verifica aggiornamenti…" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "アップデートを確認中…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在检查更新…" } }
    } },
    "Choose whether and how often Pastera checks for updates." : { "localizations" : {
      "en" : { "stringUnit" : { "state" : "translated", "value" : "Choose whether and how often Pastera checks for updates." } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Lege fest, ob und wie oft Pastera nach Updates sucht." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Scegli se e con quale frequenza Pastera verifica gli aggiornamenti." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "Pastera がアップデートを確認するかどうかと頻度を選択します。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "选择 Pastera 是否以及多久检查一次更新。" } }
    } },
    "Current Version" : { "localizations" : {
      "en" : { "stringUnit" : { "state" : "translated", "value" : "Current Version" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Aktuelle Version" } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Versione attuale" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "現在のバージョン" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "当前版本" } }
    } },
    "Notify you when a new version is available." : { "localizations" : {
      "en" : { "stringUnit" : { "state" : "translated", "value" : "Notify you when a new version is available." } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Benachrichtigt dich, wenn eine neue Version verfügbar ist." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Ti avvisa quando è disponibile una nuova versione." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "新しいバージョンが利用可能になると通知します。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "有新版本时通知你。" } }
    } },
    "Ready to Check for Updates" : { "localizations" : {
      "en" : { "stringUnit" : { "state" : "translated", "value" : "Ready to Check for Updates" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Bereit zur Update-Suche" } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Pronto per verificare gli aggiornamenti" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "アップデートを確認できます" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "可以检查更新" } }
    } },
    "Release Notes" : { "localizations" : {
      "en" : { "stringUnit" : { "state" : "translated", "value" : "Release Notes" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Versionshinweise" } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Note di rilascio" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "リリースノート" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "版本说明" } }
    } },
    "Review an available update before downloading and installing it." : { "localizations" : {
      "en" : { "stringUnit" : { "state" : "translated", "value" : "Review an available update before downloading and installing it." } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Prüfe ein verfügbares Update vor dem Herunterladen und Installieren." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Controlla un aggiornamento disponibile prima di scaricarlo e installarlo." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "利用可能なアップデートを確認してからダウンロードしてインストールします。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "下载并安装前先确认可用更新。" } }
    } },
    "Review the last check time and release history." : { "localizations" : {
      "en" : { "stringUnit" : { "state" : "translated", "value" : "Review the last check time and release history." } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Zeigt die letzte Prüfung und den Versionsverlauf." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Consulta l'ultima verifica e la cronologia delle versioni." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "前回の確認日時とリリース履歴を表示します。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "查看上次检查时间和版本历史。" } }
    } },
    "Show the installed version and check for updates." : { "localizations" : {
