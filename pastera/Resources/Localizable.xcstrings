    "Check access to the password vault file, then try again." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Check access to the password vault file, then try again." } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Prüfe den Zugriff auf die Passworttresordatei und versuche es erneut." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Controlla l'accesso al file della cassaforte password e riprova." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "パスワード保管庫ファイルへのアクセスを確認して、もう一度お試しください。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "检查密码箱文件访问权限后重试。" } } } },
    "Confirm New Master Password" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Confirm New Master Password" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Neues Master-Passwort bestätigen" } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Conferma nuova password principale" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "新しいマスターパスワードを確認" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "确认新主密码" } } } },
    "Current Master Password" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Current Master Password" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Aktuelles Master-Passwort" } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Password principale attuale" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "現在のマスターパスワード" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "当前主密码" } } } },
    "Enable quick unlock to use this Mac's authentication next time." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Enable quick unlock to use this Mac's authentication next time." } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Aktiviere die Schnellentsperrung, um beim nächsten Mal die Mac-Authentifizierung zu verwenden." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Attiva lo sblocco rapido per usare l'autenticazione del Mac la prossima volta." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "次回このMacの認証を使うにはクイックロック解除を有効にしてください。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "启用快速解锁后，下次可使用这台 Mac 的认证。" } } } },
    "Enter a new master password." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Enter a new master password." } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Gib ein neues Master-Passwort ein." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Inserisci una nuova password principale." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "新しいマスターパスワードを入力してください。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请输入新主密码。" } } } },
    "Enter the current master password." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Enter the current master password." } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Gib das aktuelle Master-Passwort ein." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Inserisci la password principale attuale." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "現在のマスターパスワードを入力してください。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请输入当前主密码。" } } } },
    "Lock after the selected period of inactivity." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Lock after the selected period of inactivity." } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Nach der gewählten Inaktivitätsdauer sperren." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Blocca dopo il periodo di inattività selezionato." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "選択した時間操作がないとロックします。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "在所选时长内无操作后锁定。" } } } },
    "Locked" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Locked" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Gesperrt" } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Bloccata" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ロック中" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已锁定" } } } },
    "Locking & Unlocking" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Locking & Unlocking" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Sperren und Entsperren" } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Blocco e sblocco" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ロックとロック解除" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "锁定与解锁" } } } },
    "Manage password vault locking, unlocking, and master password." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Manage password vault locking, unlocking, and master password." } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Verwalte Sperren, Entsperren und Master-Passwort des Passworttresors." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Gestisci blocco, sblocco e password principale della cassaforte." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "パスワード保管庫のロック、ロック解除、マスターパスワードを管理します。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "管理密码箱的锁定、解锁和主密码。" } } } },
    "Master password changed." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Master password changed." } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Master-Passwort geändert." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Password principale modificata." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "マスターパスワードを変更しました。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "主密码已修改。" } } } },
    "New Master Password" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "New Master Password" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Neues Master-Passwort" } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Nuova password principale" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "新しいマスターパスワード" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "新主密码" } } } },
    "Not Set Up" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Not Set Up" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Nicht eingerichtet" } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Non configurata" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "未設定" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "未设置" } } } },
    "Open Password Vault Setup" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Open Password Vault Setup" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Passworttresor einrichten" } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Apri configurazione cassaforte" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "パスワード保管庫の設定を開く" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "前往密码箱设置" } } } },
    "Processing" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Processing" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Wird verarbeitet" } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Elaborazione" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "処理中" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在处理" } } } },
    "Quick unlock is ready on this Mac." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Quick unlock is ready on this Mac." } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Die Schnellentsperrung ist auf diesem Mac bereit." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Lo sblocco rapido è pronto su questo Mac." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "このMacでクイックロック解除を使用できます。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "这台 Mac 已可使用快速解锁。" } } } },
    "Quick unlock was turned off. Unlock the vault and enable it again." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Quick unlock was turned off. Unlock the vault and enable it again." } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Die Schnellentsperrung wurde deaktiviert. Entsperre den Tresor und aktiviere sie erneut." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Lo sblocco rapido è stato disattivato. Sblocca la cassaforte e riattivalo." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "クイックロック解除は無効になりました。保管庫をロック解除して再度有効にしてください。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "快速解锁已关闭，请解锁密码箱后重新启用。" } } } },
    "Read Only" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Read Only" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Schreibgeschützt" } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Sola lettura" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "読み取り専用" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "只读" } } } },
    "Resolve the sync conflict, then try again without closing this sheet." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Resolve the sync conflict, then try again without closing this sheet." } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Löse den Synchronisierungskonflikt und versuche es erneut, ohne dieses Fenster zu schließen." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Risolvi il conflitto di sincronizzazione e riprova senza chiudere questo pannello." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "このシートを閉じずに同期の競合を解決して、もう一度お試しください。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请先解决同步冲突，再在不关闭此窗口的情况下重试。" } } } },
    "Resolve the sync conflict, then try again." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Resolve the sync conflict, then try again." } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Löse den Synchronisierungskonflikt und versuche es erneut." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Risolvi il conflitto di sincronizzazione e riprova." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "同期の競合を解決して、もう一度お試しください。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请先解决同步冲突，然后重试。" } } } },
    "Resolve the sync or file access issue before changing the master password." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Resolve the sync or file access issue before changing the master password." } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Behebe das Synchronisierungs- oder Dateizugriffsproblem, bevor du das Master-Passwort änderst." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Risolvi il problema di sincronizzazione o accesso ai file prima di cambiare la password principale." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "マスターパスワードを変更する前に同期またはファイルアクセスの問題を解決してください。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请先解决同步或文件访问问题，再修改主密码。" } } } },
    "Restore access to the password vault file before changing security settings." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Restore access to the password vault file before changing security settings." } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Stelle den Zugriff auf die Passworttresordatei wieder her, bevor du Sicherheitseinstellungen änderst." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Ripristina l'accesso al file della cassaforte prima di modificare le impostazioni di sicurezza." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "セキュリティ設定を変更する前にパスワード保管庫ファイルへのアクセスを復元してください。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请先恢复密码箱文件访问，再修改安全设置。" } } } },
    "Set up the password vault from the main menu before configuring security options." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Set up the password vault from the main menu before configuring security options." } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Richte den Passworttresor im Hauptmenü ein, bevor du Sicherheitsoptionen konfigurierst." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Configura la cassaforte password dal menu principale prima delle opzioni di sicurezza." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "セキュリティオプションを設定する前にメインメニューからパスワード保管庫を設定してください。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请先在主菜单设置密码箱，再配置安全选项。" } } } },
    "The current master password is incorrect." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The current master password is incorrect." } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Das aktuelle Master-Passwort ist falsch." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "La password principale attuale non è corretta." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "現在のマスターパスワードが正しくありません。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "当前主密码不正确。" } } } },
    "The master password could not be changed. Please try again." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The master password could not be changed. Please try again." } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Das Master-Passwort konnte nicht geändert werden. Versuche es erneut." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Impossibile modificare la password principale. Riprova." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "マスターパスワードを変更できませんでした。もう一度お試しください。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法修改主密码，请重试。" } } } },
    "The master password encrypts your password vault. If forgotten, it cannot be recovered by any other means." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The master password encrypts your password vault. If forgotten, it cannot be recovered by any other means." } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Das Master-Passwort verschlüsselt deinen Passworttresor. Wenn du es vergisst, kann es auf keinem anderen Weg wiederhergestellt werden." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "La password principale cifra la cassaforte. Se la dimentichi, non può essere recuperata in nessun altro modo." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "マスターパスワードはパスワード保管庫を暗号化します。忘れた場合、ほかの方法では復元できません。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "主密码用于加密密码箱。忘记后无法通过其他方式找回。" } } } },
    "The new master password encrypts your password vault. If forgotten, it cannot be recovered by any other means." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The new master password encrypts your password vault. If forgotten, it cannot be recovered by any other means." } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Das neue Master-Passwort verschlüsselt deinen Passworttresor. Wenn du es vergisst, kann es auf keinem anderen Weg wiederhergestellt werden." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "La nuova password principale cifra la cassaforte. Se la dimentichi, non può essere recuperata in nessun altro modo." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "新しいマスターパスワードはパスワード保管庫を暗号化します。忘れた場合、ほかの方法では復元できません。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "新主密码用于加密密码箱。忘记后无法通过其他方式找回。" } } } },
    "The new master passwords do not match." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The new master passwords do not match." } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Die neuen Master-Passwörter stimmen nicht überein." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Le nuove password principali non corrispondono." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "新しいマスターパスワードが一致しません。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "两次输入的新主密码不一致。" } } } },
    "The password vault file could not be saved. Check file access and try again." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The password vault file could not be saved. Check file access and try again." } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Die Passworttresordatei konnte nicht gespeichert werden. Prüfe den Dateizugriff und versuche es erneut." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Impossibile salvare il file della cassaforte. Controlla l'accesso e riprova." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "パスワード保管庫ファイルを保存できませんでした。ファイルアクセスを確認して、もう一度お試しください。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法保存密码箱文件，请检查文件访问权限后重试。" } } } },
    "The security setting could not be updated. Please try again." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The security setting could not be updated. Please try again." } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Die Sicherheitseinstellung konnte nicht aktualisiert werden. Versuche es erneut." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Impossibile aggiornare l'impostazione di sicurezza. Riprova." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "セキュリティ設定を更新できませんでした。もう一度お試しください。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法更新安全设置，请重试。" } } } },
    "The vault is locked. Quick unlock remains available on this Mac." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The vault is locked. Quick unlock remains available on this Mac." } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Der Tresor ist gesperrt. Die Schnellentsperrung bleibt auf diesem Mac verfügbar." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "La cassaforte è bloccata. Lo sblocco rapido resta disponibile su questo Mac." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "保管庫はロックされています。このMacではクイックロック解除を引き続き使用できます。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "密码箱已锁定，仍可在这台 Mac 上使用快速解锁。" } } } },
    "This Mac could not update quick unlock. Try again after unlocking the vault." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "This Mac could not update quick unlock. Try again after unlocking the vault." } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Dieser Mac konnte die Schnellentsperrung nicht aktualisieren. Entsperre den Tresor und versuche es erneut." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Questo Mac non ha potuto aggiornare lo sblocco rapido. Sblocca la cassaforte e riprova." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "このMacでクイックロック解除を更新できませんでした。保管庫をロック解除して再試行してください。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "这台 Mac 无法更新快速解锁，请解锁密码箱后重试。" } } } },
    "Unlock the password vault and try again." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Unlock the password vault and try again." } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Entsperre den Passworttresor und versuche es erneut." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Sblocca la cassaforte password e riprova." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "パスワード保管庫をロック解除して、もう一度お試しください。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请解锁密码箱后重试。" } } } },
    "Unlock the vault from the main menu before enabling quick unlock." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Unlock the vault from the main menu before enabling quick unlock." } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Entsperre den Tresor im Hauptmenü, bevor du die Schnellentsperrung aktivierst." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Sblocca la cassaforte dal menu principale prima di attivare lo sblocco rapido." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "クイックロック解除を有効にする前にメインメニューから保管庫をロック解除してください。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请先在主菜单解锁密码箱，再启用快速解锁。" } } } },
    "Unlocked" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Unlocked" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Entsperrt" } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Sbloccata" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "ロック解除済み" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已解锁" } } } },
    "Use this Mac's authentication instead of entering the master password." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Use this Mac's authentication instead of entering the master password." } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Verwende die Mac-Authentifizierung, statt das Master-Passwort einzugeben." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Usa l'autenticazione del Mac invece di inserire la password principale." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "マスターパスワードの入力の代わりにこのMacの認証を使用します。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "使用这台 Mac 的认证，无需输入主密码。" } } } },
    "Verify your current master password, then choose a new one. Your folders and entries will be preserved." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Verify your current master password, then choose a new one. Your folders and entries will be preserved." } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Bestätige dein aktuelles Master-Passwort und wähle ein neues. Ordner und Einträge bleiben erhalten." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Verifica la password principale attuale e scegline una nuova. Cartelle e voci saranno conservate." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "現在のマスターパスワードを確認してから新しいものを選択します。フォルダと項目は保持されます。" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "验证当前主密码后设置新密码，所有文件夹和条目都会保留。" } } } },
