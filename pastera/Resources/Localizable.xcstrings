    "OneDrive is not installed; password vault sync is not enabled" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "未安装 OneDrive · 密码箱同步未开启" } } } },
    "OneDrive is not running." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "OneDrive 未运行。" } } } },
    "OneDrive is not running; password vault sync is not enabled" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "OneDrive 未运行 · 密码箱同步未开启" } } } },
    "The selected OneDrive folder is unavailable." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "所选 OneDrive 目录不可用。" } } } },
    "The selected OneDrive folder is read-only." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "所选 OneDrive 目录为只读。" } } } },
    "The OneDrive replica is temporarily unavailable." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "OneDrive 副本暂时不可用。" } } } },
    "The OneDrive replica cannot be read safely." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法安全读取 OneDrive 副本。" } } } },
    "The OneDrive replica uses a different master password." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "OneDrive 副本使用了不同的主密码。" } } } },
    "The encrypted replica could not be saved to OneDrive." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法将加密副本保存到 OneDrive。" } } } },
    "The saved OneDrive replica could not be verified." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法验证已保存的 OneDrive 副本。" } } } },
    "OneDrive could not be started." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法启动 OneDrive。" } } } },
    "OneDrive sync is unavailable" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "OneDrive 同步不可用" } } } },
    "Review Sync Result" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "查看同步结果" } } } },
    "Create a Separate Local Vault?" : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "创建独立的本地密码箱？" } } } },
    "Creating a new local vault starts a separate data branch." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "创建新的本地密码箱会形成一条独立的数据分支。" } } } },
    "The previous OneDrive vault will not be overwritten. You can reconnect it later and decide how to merge the two copies." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "原有 OneDrive 密码箱不会被覆盖。你可以稍后重新连接，再决定如何合并两端副本。" } } } },
