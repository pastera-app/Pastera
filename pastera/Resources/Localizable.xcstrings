    "%lld conflict copies are available." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "有 %lld 个冲突副本。" } } } },
    "Queued changes remain on this Mac." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "等待中的更改仍保存在这台 Mac 上。" } } } },
    "The encrypted replica is up to date." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "加密副本已是最新。" } } } },
    "Keep working normally. Pastera will upload queued changes after OneDrive reconnects." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "你可以继续正常使用。OneDrive 恢复连接后，Pastera 会上传等待中的更改。" } } } },
    "The encrypted local vault and OneDrive replica are up to date." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "加密的本地密码箱与 OneDrive 副本均为最新。" } } } },
    "Pastera is updating the encrypted OneDrive replica." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Pastera 正在更新加密的 OneDrive 副本。" } } } },
    "Your vault stays unlocked. Conflict copies can be reviewed later." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "密码箱会保持解锁，冲突副本可以稍后检查。" } } } },
    "Unlock the local vault to finish merging remote changes." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "解锁本地密码箱以完成远端更改合并。" } } } },
    "Local changes remain safe. Check OneDrive and try again." : { "localizations" : { "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "本地更改仍然安全。请检查 OneDrive 后重试。" } } } },
