    "OneDrive Sync Description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pastera syncs through the OneDrive folder on your Mac without connecting to a Microsoft account. The selected location must be inside OneDrive and writable. Check the OneDrive app for cloud upload status."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pastera synchronisiert über den OneDrive-Ordner auf Ihrem Mac, ohne eine Verbindung zu einem Microsoft-Konto herzustellen. Der ausgewählte Speicherort muss sich in OneDrive befinden und beschreibbar sein. Den Cloud-Uploadstatus sehen Sie in der OneDrive-App."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pastera sincronizza tramite la cartella OneDrive sul Mac senza collegarsi a un account Microsoft. La posizione selezionata deve trovarsi in OneDrive ed essere scrivibile. Controlla l'app OneDrive per lo stato del caricamento nel cloud."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PasteraはMicrosoftアカウントに接続せず、Mac上のOneDriveフォルダを使って同期します。選択する場所はOneDrive内にあり、書き込み可能である必要があります。クラウドへのアップロード状況はOneDriveアプリで確認してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pastera 使用 Mac 上的 OneDrive 文件夹同步，不连接 Microsoft 账号。所选位置必须位于 OneDrive 内并且可写入；云端上传状态请在 OneDrive 客户端中查看。"
          }
        }
      }
    },
